# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=oftallearn
POSTGRES_PASSWORD=oftallearn
POSTGRES_DB=oftallearn
# Puerto en tu máquina para el PostgreSQL de Docker (5433 evita
# conflictos con un PostgreSQL local que use el 5432)
POSTGRES_PORT=5433

# ── Backend (FastAPI) ───────────────────────────────────────
# Clave para firmar los JWT. Genera una segura: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Client ID de Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Orígenes permitidos por CORS (separados por comas)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://0.0.0.0:3000

# Correos que obtienen rol de profesor automáticamente al registrarse
TEACHER_EMAILS=

# Login de desarrollo sin Google (true/false). Úsalo solo en local.
DEV_AUTH_ENABLED=true

# ── Frontend (React/Vite, se usan en el build de Docker) ────
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
