# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=oftallearn
POSTGRES_PASSWORD=oftallearn
POSTGRES_DB=oftallearn
# Puerto en tu máquina para el PostgreSQL de Docker (5433 evita
# conflictos con un PostgreSQL local que use el 5432)
POSTGRES_PORT=5433

# ── Backend (FastAPI) ───────────────────────────────────────
# Clave para firmar los JWT. Genera una segura: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Client ID de Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Orígenes permitidos por CORS (separados por comas)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://0.0.0.0:3000

# Correos que obtienen rol de profesor automáticamente al registrarse
TEACHER_EMAILS=

# Login de desarrollo sin Google (true/false). Úsalo solo en local.
DEV_AUTH_ENABLED=true

# Modelo local de embeddings para el RAG (corre en CPU, sin APIs externas).
# Multilingüe (incluye español), 384 dimensiones.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# OpenRouter (IA) — genera tu clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-tu-clave
OPENROUTER_NORMALIZE_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_ANSWER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_ASK_RATE_LIMIT=60/hour
OPENROUTER_GLOBAL_LIMIT_PER_MIN=18

# Google Gemini (IA) — proveedor alternativo. Genera tu clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Selector de proveedor LLM para /api/ai/ask: "openrouter" o "gemini"
AI_PROVIDER=openrouter

# Generación de preguntas con IA (solo profesores)
AI_QUESTION_RATE_LIMIT=5/hour
AI_QUESTION_MAX_ATTEMPTS=2

# Tope de preguntas por quiz del estudiante (muestreo aleatorio si hay más)
QUIZ_MAX_QUESTIONS=10

# Respuestas de quiz calificadas en servidor (por estudiante y hora)
QUIZ_ANSWER_RATE_LIMIT=120/hour

# ── Modo práctica (banco + IA reutilizable) ─────────────────
PRACTICE_RATE_LIMIT=30/hour
PRACTICE_DEFAULT_COUNT=5
PRACTICE_MAX_COUNT=10
PRACTICE_AI_RATIO=0.4
PRACTICE_MAX_GENERATIONS_PER_SUBTOPIC_PER_DAY=4

# ── Frontend (React/Vite, se usan en el build de Docker) ────
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
