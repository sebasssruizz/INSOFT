# Variables del frontend (copiar a .env). Sin secretos durante el build público.
# Todas las llamadas a la API usan esta URL; en Vercel se define como
# Environment Variable de producción/preview (p. ej. https://insoft-backend.onrender.com).
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=
# login de desarrollo (sin Google): SOLO en local
VITE_DEV_AUTH=false
